{
  "name": "tailwindcss-custom-colors",
  "version": "1.1.0",
  "description": "Generate a full Tailwind CSS shade scale, CSS variables and contrast colors from a single hex color.",
  "keywords": [
    "colors",
    "contrast",
    "css-variables",
    "palette",
    "shades",
    "tailwind",
    "tailwindcss",
    "tints",
    "typescript"
  ],
  "homepage": "https://github.com/quentinjuarez/tailwindcss-custom-colors#readme",
  "bugs": "https://github.com/quentinjuarez/tailwindcss-custom-colors/issues",
  "license": "MIT",
  "author": "quentinjuarez (https://www.quentinjuarez.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quentinjuarez/tailwindcss-custom-colors.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt . '!**/global.d.ts'",
    "format:check": "oxfmt --check . '!**/global.d.ts'",
    "verify": "yarn lint && yarn format:check && yarn typecheck && yarn test && yarn build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.18",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@3.8.6"
}
