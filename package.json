{
  "name": "tailwindcss-custom-colors",
  "version": "2.1.0",
  "description": "Turn one color into a Tailwind CSS 4 theme: OKLCH shade scale, dark scale and contrast color, as CSS variables you can swap at runtime.",
  "keywords": [
    "colors",
    "contrast",
    "css-variables",
    "design-tokens",
    "oklch",
    "palette",
    "shades",
    "tailwind",
    "tailwindcss",
    "theme",
    "typescript"
  ],
  "homepage": "https://github.com/quentinjuarez/tailwindcss-custom-colors#readme",
  "bugs": "https://github.com/quentinjuarez/tailwindcss-custom-colors/issues",
  "license": "MIT",
  "author": "quentinjuarez (https://www.quentinjuarez.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quentinjuarez/tailwindcss-custom-colors.git"
  },
  "bin": "./dist/esm/bin.js",
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/write-dist-package-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt . '!**/global.d.ts'",
    "format:check": "oxfmt --check . '!**/global.d.ts'",
    "assets": "yarn build && node scripts/generate-assets.mjs",
    "test:dist": "node tests/smoke/dist.cjs && node tests/smoke/dist.mjs && node tests/smoke/cli.mjs",
    "verify": "yarn lint && yarn format:check && yarn typecheck && yarn test && yarn build && yarn test:dist"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "culori": "^4.0.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@3.8.6"
}
