{
  "compilerOptions": {
    // CommonJS on purpose: this package is imported from tailwind.config.js
    // files, which are still CJS in most projects. Switching to ESM like the
    // sibling packages would break every one of them.
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "Node",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
